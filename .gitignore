# Cmake generated folders
/cmake*
!/CMakePresets.json
/build*

# xmake generated folders
/.xmake*

# idea project files
/.idea

# local tool indexes
/.codegraph
/.code-review-graph

# third-party dependencies
/dependencies

# binary files
*.exe
*.obj

# clangd compilation database (xmake generated)
/compile_commands.json

# VS Code editor settings (editor-specific, never shared)
.vscode/

# Visual Studio local state and CMake preset output
/.vs
/out

# xmake-generated Visual Studio projects (regenerate: xmake project -k vsxmake2026)
/vsxmake*/
